---
interface Props {
    src?: string;
    alt?: string;
    theme: string;
}

const { src, alt, theme } = Astro.props;
---

<div class="relative group rounded-2xl overflow-hidden bg-surface dark:bg-surface-dark border border-border dark:border-border-dark p-4">
    <div class="mx-auto max-w-[180px] lg:max-w-[200px]">
        <div class="relative bg-gray-900 rounded-[2rem] p-2 shadow-xl">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-20 h-6 bg-gray-900 rounded-b-2xl z-10"></div>
            <div class="rounded-[1.5rem] overflow-hidden bg-background dark:bg-background-dark aspect-[9/19]">
                {src ? (
                    <img
                        src={src}
                        alt={alt || 'Mobile screenshot'}
                        class="w-full h-full object-cover"
                    />
                ) : (
                    <div 
                        class="w-full h-full flex items-center justify-center"
                        style={`background: linear-gradient(180deg, ${theme}30, transparent)`}
                    >
                        <svg class="w-12 h-12 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                    </div>
                )}
            </div>
        </div>
    </div>
</div>
